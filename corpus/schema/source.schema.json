{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemmacore.com/schemas/brand-expert-core/source.schema.json",
  "title": "Brand Expert Core — Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "authors", "topics", "tier", "verification", "summary"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug; must equal the record's filename without .json"
    },
    "type": {
      "enum": ["book", "journal_article", "report", "standard", "website"]
    },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": ["string", "null"] },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publisher": { "type": ["string", "null"] },
    "first_published_year": { "type": ["integer", "null"], "minimum": 1800, "maximum": 2100 },
    "latest_edition": { "type": ["string", "null"] },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isbn_13": {
          "type": ["string", "null"],
          "pattern": "^97[89]\\d{10}$",
          "description": "Digits only, no hyphens; must pass ISBN-13 checksum (validator-enforced)"
        },
        "doi": {
          "type": ["string", "null"],
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        },
        "url": { "type": ["string", "null"], "pattern": "^https?://" }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Each entry must exist in corpus/taxonomy/topics.json (validator-enforced)"
    },
    "tier": {
      "enum": ["canonical", "standard", "supplementary"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["verified", "pending", "rejected"] },
        "verified_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "method": { "type": ["string", "null"] },
        "evidence_url": { "type": ["string", "null"], "pattern": "^https?://" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "description": "One-paragraph account of what the source contributes to the corpus"
    }
  }
}
